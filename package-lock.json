{
  "name": "letteron",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "letteron",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "apps/api": {
      "name": "@letteron/api",
      "version": "0.0.0"
    },
    "apps/extension": {
      "name": "@letteron/extension",
      "version": "0.0.0"
    },
    "apps/web": {
      "name": "@letteron/web",
      "version": "0.0.0"
    },
    "node_modules/@letteron/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@letteron/db": {
      "resolved": "packages/db",
      "link": true
    },
    "node_modules/@letteron/design-system": {
      "resolved": "packages/design-system",
      "link": true
    },
    "node_modules/@letteron/extension": {
      "resolved": "apps/extension",
      "link": true
    },
    "node_modules/@letteron/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@letteron/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/db": {
      "name": "@letteron/db",
      "version": "0.0.0"
    },
    "packages/design-system": {
      "name": "@letteron/design-system",
      "version": "0.1.0"
    },
    "packages/shared": {
      "name": "@letteron/shared",
      "version": "0.0.0"
    }
  }
}
